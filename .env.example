# ローカル開発用の例。コピーした.envには十分に長いランダム値を設定する。
POSTGRES_DB=sorasense
POSTGRES_USER=sorasense_owner
POSTGRES_PASSWORD=replace-with-a-random-local-password
SORASENSE_MIGRATOR_PASSWORD=replace-with-a-different-random-local-password
SORASENSE_APP_PASSWORD=replace-with-a-different-random-local-password
GRAFANA_READER_PASSWORD=replace-with-a-different-random-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-different-random-local-password
# M5StickC Plus2と同じLANから到達できる、このホストのプライベートIPv4を設定する。
APP_BIND_ADDRESS=192.168.1.100
DEVICE_ID=living-room-01
# `python scripts/generate-device-api-key-hash.py`で生成したArgon2idハッシュを一重引用符内へ設定する。
# APIキー本体は表示されず、このファイルにも保存しない。
DEVICE_API_KEY_HASH='replace-with-generated-argon2id-hash'
# `python scripts/generate-web-password-hash.py`で生成したArgon2idハッシュを一重引用符内へ設定する。
WEB_USERNAME=admin
WEB_PASSWORD_HASH='replace-with-generated-argon2id-hash'
# Gemini Developer APIのFree Tier用APIキーは実値をリポジトリへ保存しない。
GEMINI_API_KEY=
# 利用モデルはこの1行で切り替え、`docker compose up -d --force-recreate app`で反映する。
GEMINI_MODEL=gemini-3.5-flash-lite
# 異常開始閾値と復帰幅。変更後はappを再起動し、過去データは再判定しない。
TEMPERATURE_LOWER=10.0
TEMPERATURE_UPPER=35.0
TEMPERATURE_HYSTERESIS=0.5
HUMIDITY_LOWER=30.0
HUMIDITY_UPPER=70.0
HUMIDITY_HYSTERESIS=2.0
