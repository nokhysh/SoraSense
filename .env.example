# ローカル開発用の例。コピーした.envには十分に長いランダム値を設定する。
POSTGRES_DB=sorasense
POSTGRES_USER=sorasense_owner
POSTGRES_PASSWORD=replace-with-a-random-local-password
SORASENSE_MIGRATOR_PASSWORD=replace-with-a-different-random-local-password
SORASENSE_APP_PASSWORD=replace-with-a-different-random-local-password
GRAFANA_READER_PASSWORD=replace-with-a-different-random-local-password
DEVICE_ID=living-room-01
# `python scripts/generate-device-api-key-hash.py`で生成したArgon2idハッシュを設定する。
# APIキー本体は表示されず、このファイルにも保存しない。
DEVICE_API_KEY_HASH=replace-with-generated-argon2id-hash
# 異常開始閾値と復帰幅。変更後はappを再起動し、過去データは再判定しない。
TEMPERATURE_LOWER=10.0
TEMPERATURE_UPPER=35.0
TEMPERATURE_HYSTERESIS=0.5
HUMIDITY_LOWER=30.0
HUMIDITY_UPPER=70.0
HUMIDITY_HYSTERESIS=2.0
